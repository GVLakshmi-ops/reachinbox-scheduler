# --- Server ---
PORT=4000
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch (optional, only needed for /api/emails/search) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Ethereal SMTP (create a test account at https://ethereal.email) ---
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASS=your-ethereal-pass

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth (https://api.slack.com/apps) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# --- Scheduler tuning (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR=200
